{
  "mcpServers": {
    "test-sse-server": {
      "type": "sse",
      "url": "http://localhost:8080/sse",
      "headers": {
        "Authorization": "Bearer test-token"
      },
      "disabled": false
    },
    "link-reader": {
      "type": "sse",
      "prefix": "browser",
      "url": "https://mcp.byted.org/api/fc/link-reader/mcp"
    },
    "mcp-server-chart": {
      "prefix": "chart",
      "command": "npx",
      "args": [
        "-y",
        "@antv/mcp-server-chart"
      ]
    }
  }
}
